DATABASE_URL=postgresql+asyncpg://colmena:colmena@localhost:5432/colmena
DATABASE_URL_SYNC=postgresql+psycopg://colmena:colmena@localhost:5432/colmena
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET_KEY=change-me-to-a-long-random-value-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Monorepo fullProyect: cross-login con AppThesis (thesis-backend NestJS)
THESIS_API_BASE_URL=http://localhost:3000
# Orígenes CORS extra separados por coma (túneles Cloudflare de los frontends)
COLMENA_CORS_EXTRA_ORIGINS=
